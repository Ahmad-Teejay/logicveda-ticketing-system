generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DISPATCHER
  TECHNICIAN
  RESIDENT
}

model Organisation {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  users     User[]
  tickets   Ticket[]
}

model User {
  id             String       @id @default(uuid())
  organisationId String
  email          String       @unique
  passwordHash   String
  role           Role
  name           String
  skills         String[]
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  @@index([organisationId])
}

enum TicketStatus {
  NEW
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
}

model Ticket {
  id             String       @id @default(uuid())
  organisationId String
  propertyId     String
  unitId         String
  residentId     String
  title          String
  description    String
  category       String?
  priority       String?
  status         TicketStatus @default(NEW)
  assigneeId     String?
  version        Int          @default(0)
  resolvedAt     DateTime?
  isBlocking     Boolean      @default(false)
  customFields   Json?
  mergedIntoId   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  @@index([organisationId, status])
  @@index([organisationId, assigneeId])
}